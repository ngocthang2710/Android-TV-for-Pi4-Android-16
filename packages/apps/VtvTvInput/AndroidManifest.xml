<?xml version="1.0" encoding="utf-8"?>
<!--
  VTV live-channel TvInputService: plays the free-to-air VTV1-VTV9 HLS
  streams and registers them as channels in the system Live Channels
  (TvProvider) EPG, so they show up next to any other TV input.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rpi4tv.vtvinput">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher">

        <!-- Launcher entry point: tap the app icon, get a grid of channels. -->
        <activity
            android:name=".VtvChannelListActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Holo.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=true: the launcher's content_preview (see
             TvSampleLeanbackLauncher's LauncherActivity) launches this
             directly with EXTRA_CHANNEL_NUMBER to tune a specific VTV
             channel from its clickable channel-preview tiles, without
             going through VtvChannelListActivity's grid first. No new
             attack surface: the only input is a channel number string,
             same data VtvChannelListActivity already passes it from
             inside this app. -->
        <activity
            android:name=".VtvPlayerActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true" />

        <!-- TvInputService setup hook: launched by TvProvision/Live Channels
             with EXTRA_INPUT_ID, not meant to be a user-visible app icon. -->
        <activity
            android:name=".VtvSetupActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Holo.Light.Dialog.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <service
            android:name=".VtvTvInputService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TV_INPUT"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/vtvtvinputservice" />
        </service>
    </application>
</manifest>
