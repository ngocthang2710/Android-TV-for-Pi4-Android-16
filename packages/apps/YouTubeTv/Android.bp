package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "YouTubeTv",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    sdk_version: "current",
    target_sdk_version: "current",

    // Preinstalled on the Android TV product only (see aosp_rpi4_tv.mk).
    // Regular (non-privileged) app: a WebView wrapper around youtube.com/tv
    // needs no special OS permissions beyond INTERNET, so no priv-app
    // allowlist entry is needed either -- see AndroidManifest.xml.
    product_specific: true,

    optimize: {
        enabled: false,
    },
}
