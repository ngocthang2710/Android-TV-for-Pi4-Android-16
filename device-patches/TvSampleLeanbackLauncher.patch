+     middle area: actual per-app usage data (UsageStatsManager), not a
+     fabricated content list; see
+     LauncherActivity#refreshRecentlyOpenedApps(). Sits above
+     content_preview.xml in bottom_stack, always shown once there's real
+     usage data (not focus-reactive like content_preview; "recently used"
+     isn't a property of whichever item currently has focus). Hidden
+     entirely if there's no usage data yet (e.g. right after first boot)
+     rather than showing an empty row. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/recent_apps_container"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:layout_marginBottom="12dp"
+    android:paddingStart="@dimen/overscan_horizontal"
+    android:paddingEnd="@dimen/overscan_horizontal"
+    android:clipChildren="false"
+    android:clipToPadding="false"
+    android:visibility="gone">
+
+    <TextView
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="6dp"
+        android:text="@string/recent_apps_title"
+        android:textSize="14sp"
+        android:textColor="@color/hero_subtitle_text_color" />
+
+    <HorizontalScrollView
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:scrollbars="none"
+        android:clipToPadding="false"
+        android:clipChildren="false">
+
+        <LinearLayout
+            android:id="@+id/recent_apps_row"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:clipChildren="false"
+            android:clipToPadding="false" />
+    </HorizontalScrollView>
+</LinearLayout>
