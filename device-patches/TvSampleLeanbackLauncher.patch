+  ~ WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  ~ See the License for the specific language governing permissions and
+  ~ limitations under the License
+  -->
+
+<!-- Soft rounded capsule behind a whole top_bar button group (the
+     Search/Home/Live/Apps cluster, and separately the assistant/home/
+     settings cluster) in top_bar.xml, matching a reference Google TV Home
+     screenshot: the group itself sits on a translucent pill, and the
+     active tab's own solid pill (top_bar_active_tab_background) then sits
+     on top of that. This is a distinct layer from that one; adding it
+     was the missing piece before this looked like plain icons floating on
+     the backdrop instead of a grouped control. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="rectangle">
+    <solid android:color="@color/top_bar_group_background" />
+    <corners android:radius="@dimen/top_bar_group_radius" />
