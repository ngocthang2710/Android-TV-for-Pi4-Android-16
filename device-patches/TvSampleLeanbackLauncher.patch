diff --git a/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml b/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml
new file mode 100644
index 0000000..ce0bf07
--- /dev/null
+++ b/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml
@@ -0,0 +1,90 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Copyright (C) 2026 The Android Open Source Project
+  ~
+  ~ Licensed under the Apache License, Version 2.0 (the "License");
+  ~ you may not use this file except in compliance with the License.
+  ~ You may obtain a copy of the License at
+  ~
+  ~      http://www.apache.org/licenses/LICENSE-2.0
+  ~
+  ~ Unless required by applicable law or agreed to in writing, software
+  ~ distributed under the License is distributed on an "AS IS" BASIS,
+  ~ WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  ~ See the License for the specific language governing permissions and
+  ~ limitations under the License
+  -->
+
+<!-- Fills the empty middle of the screen (between the hero title and the
+     app row) with something contextual to whichever app tile currently
+     has D-pad focus, matching a reference Google TV Home screenshot's
+     "Top picks for you" row, but with real data only, never a
+     fabricated content list. See LauncherActivity#onItemFocused().
+
+     Exactly one of the two children below is visible at a time:
+     - content_preview_channels: VTV's real channel lineup (VTV1-9), since
+       that's the one app here with real structured content data this
+       launcher can read.
+     - content_preview_app_card: every other app (the WebView-wrapped
+       YouTube/Spotify/Netflix/CH Play, Settings, Live Channels, etc.);
+       none of those expose any real "suggested content" API this
+       launcher process could read, so this is a plain icon+name card,
+       not an invented content list.
+
+     Not focusable itself, same as the hero backdrop it sits above:
+     purely reactive to the app row's own focus, so it doesn't change
+     D-pad flow at all. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/content_preview"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:layout_marginBottom="16dp"
+    android:paddingStart="@dimen/overscan_horizontal"
+    android:paddingEnd="@dimen/overscan_horizontal"
+    android:clipChildren="false"
+    android:clipToPadding="false"
+    android:visibility="gone">
+
+    <!-- match_parent + equal-weight children (see
+         LauncherActivity#populateVtvChannelPreview()), not a scrollable
+         wrap_content row: user asked for this to actually use the empty
+         width on the right side of the screen ("trải rộng gần hết chiều
+         ngang màn hình") rather than sit as a small scrollable cluster on
+         the left. All 9 tiles are always on-screen at once now, so
+         there's nothing to scroll and no off-screen tile to worry about
+         reaching by D-pad. -->
+    <LinearLayout
+        android:id="@+id/content_preview_channels"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:visibility="gone" />
+
+    <LinearLayout
+        android:id="@+id/content_preview_app_card"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:background="@drawable/content_preview_card_background"
+        android:paddingStart="20dp"
+        android:paddingEnd="28dp"
+        android:paddingTop="14dp"
+        android:paddingBottom="14dp"
+        android:visibility="gone">
+
+        <ImageView
+            android:id="@+id/content_preview_app_icon"
+            android:layout_width="56dp"
+            android:layout_height="56dp" />
+
+        <TextView
+            android:id="@+id/content_preview_app_label"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="16dp"
+            android:textSize="20sp"
+            android:textColor="@color/hero_title_text_color"
+            android:textStyle="bold" />
+    </LinearLayout>
+</FrameLayout>
diff --git a/TvSampleLeanbackLauncher/src/main/res/layout/hero_banner.xml b/TvSampleLeanbackLauncher/src/main/res/layout/hero_banner.xml
