+    android:layout_marginTop="96dp"
+    android:layout_marginEnd="@dimen/overscan_horizontal"
+    android:orientation="vertical"
+    android:gravity="end"
+    android:background="@drawable/content_preview_card_background"
+    android:paddingStart="24dp"
+    android:paddingEnd="24dp"
+    android:paddingTop="18dp"
+    android:paddingBottom="18dp"
+    android:clipChildren="false"
+    android:clipToPadding="false">
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:gravity="center_vertical">
+
+        <TextView
+            android:id="@+id/status_panel_network_label"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginEnd="10dp"
+            android:textSize="16sp"
+            android:textColor="@color/hero_subtitle_text_color" />
+
+        <ImageView
+            android:id="@+id/status_panel_network_icon"
+            android:layout_width="22dp"
+            android:layout_height="22dp" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/status_panel_storage_label"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="8dp"
+        android:textSize="16sp"
+        android:textColor="@color/hero_subtitle_text_color" />
+</LinearLayout>
diff --git a/TvSampleLeanbackLauncher/src/main/res/layout/top_bar.xml b/TvSampleLeanbackLauncher/src/main/res/layout/top_bar.xml
new file mode 100644
index 0000000..9d085eb
--- /dev/null
+++ b/TvSampleLeanbackLauncher/src/main/res/layout/top_bar.xml
@@ -0,0 +1,229 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Copyright (C) 2026 The Android Open Source Project
+  ~
+  ~ Licensed under the Apache License, Version 2.0 (the "License");
+  ~ you may not use this file except in compliance with the License.
+  ~ You may obtain a copy of the License at
+  ~
+  ~      http://www.apache.org/licenses/LICENSE-2.0
+  ~
+  ~ Unless required by applicable law or agreed to in writing, software
+  ~ distributed under the License is distributed on an "AS IS" BASIS,
+  ~ WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  ~ See the License for the specific language governing permissions and
+  ~ limitations under the License
+  -->
+
+<!-- Fixed top bar, laid out left to right to match a reference Google TV
+     Home screenshot:
+       [search+Home+Live+Apps, one translucent pill group]  ....
+       .... [assistant+home+settings, a second translucent pill group]  ....  [clock] [app name]
+
+     Two distinct pill layers, both matching the reference: each whole
+     button group sits on its own translucent rounded capsule
+     (top_bar_group_background), and inside the left group the currently
+     focused Home/Live/Apps tab additionally gets its own opaque white
+     pill (top_bar_active_tab_background) on top of that. Confirmed
+     on-device this group-level capsule was the piece missing before: without
+     it the buttons read as loose icons floating on the backdrop instead of
+     a grouped control.
+
+     Deliberately NOT replicated from that reference: a profile avatar
+     circle, since this launcher has no account system. (top_bar_brand did
+     originally show this app's own name instead of "Google TV", since this
+     build isn't Google TV certified; changed back to the literal reference
+     text per explicit user request, on this personal, non-distributed
+     device.)
+     "Live" launches com.android.tv/.TvActivity directly (confirmed via
+     `adb shell cmd package query-activities` to be the actual Live TV
+     activity on this device, isDefault=true for
+     CATEGORY_LEANBACK_LAUNCHER), not a guess. The right-hand "home" icon
+     and the assistant/sparkle icon don't have distinct real destinations
+     of their own here, so they're wired to the same actions as
+     top_bar_home and top_bar_search respectively, see
+     LauncherActivity#setUpTopBar().
+
+     Overlays the top edge of the backdrop (see launcher.xml, added as the
+     last child so it paints above everything). Click handling and the
+     clock are wired up in LauncherActivity. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/top_bar"
+    android:layout_width="match_parent"
+    android:layout_height="@dimen/top_bar_height"
+    android:layout_gravity="top"
+    android:orientation="horizontal"
+    android:gravity="center_vertical"
+    android:paddingStart="@dimen/overscan_horizontal"
+    android:paddingEnd="@dimen/overscan_horizontal"
+    android:clipToPadding="false"
+    android:clipChildren="false">
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="@dimen/top_bar_group_height"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:background="@drawable/top_bar_group_background"
+        android:paddingStart="@dimen/top_bar_group_padding_horizontal"
+        android:paddingEnd="@dimen/top_bar_group_padding_horizontal">
+
+        <!-- Current Google account entry point, matching the avatar circle
+             shown before Search in a reference Google TV Home screenshot.
+             See ic_account.xml for why this is a generic avatar glyph
+             rather than the real account photo. -->
+        <ImageView
+            android:id="@+id/top_bar_account"
+            android:layout_width="@dimen/top_bar_group_height"
+            android:layout_height="@dimen/top_bar_group_height"
+            android:padding="12dp"
+            android:background="@drawable/top_bar_account_background"
+            android:clickable="true"
+            android:focusable="true"
+            android:src="@drawable/ic_account"
+            android:tint="@color/top_bar_text_color"
+            android:contentDescription="@string/top_bar_account_content_description" />
+
+        <ImageView
+            android:id="@+id/top_bar_search"
+            android:layout_width="@dimen/top_bar_icon_size"
+            android:layout_height="@dimen/top_bar_icon_size"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:background="?android:attr/selectableItemBackground"
+            android:clickable="true"
+            android:focusable="true"
+            android:src="@drawable/ic_search"
+            android:tint="@color/top_bar_text_color"
+            android:contentDescription="@string/top_bar_search" />
+
+        <!-- Home/Live/Apps: the pill background + dark bold text is a FOCUS
+             state, not a fixed "current page" indicator, since this launcher
+             has no separate Home/Live/Apps screens, so there's nothing else
+             for it to mean. All three start with identical padding/inactive
+             styling in XML; which one looks "active" is driven purely by real
+             D-pad/touch focus, see LauncherActivity#setUpTopBarTab(). -->
+        <TextView
+            android:id="@+id/top_bar_home"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:paddingStart="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingEnd="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingTop="@dimen/top_bar_pill_padding_vertical"
+            android:paddingBottom="@dimen/top_bar_pill_padding_vertical"
+            android:clickable="true"
+            android:focusable="true"
+            android:text="@string/top_bar_home"
+            android:textSize="@dimen/top_bar_text_size"
+            android:textColor="@color/top_bar_text_color_inactive" />
+
+        <TextView
+            android:id="@+id/top_bar_live"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:paddingStart="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingEnd="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingTop="@dimen/top_bar_pill_padding_vertical"
+            android:paddingBottom="@dimen/top_bar_pill_padding_vertical"
+            android:clickable="true"
+            android:focusable="true"
+            android:text="@string/top_bar_live"
+            android:textSize="@dimen/top_bar_text_size"
+            android:textColor="@color/top_bar_text_color_inactive" />
+
+        <TextView
+            android:id="@+id/top_bar_apps"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:paddingStart="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingEnd="@dimen/top_bar_pill_padding_horizontal"
+            android:paddingTop="@dimen/top_bar_pill_padding_vertical"
+            android:paddingBottom="@dimen/top_bar_pill_padding_vertical"
+            android:clickable="true"
+            android:focusable="true"
+            android:text="@string/top_bar_apps"
+            android:textSize="@dimen/top_bar_text_size"
+            android:textColor="@color/top_bar_text_color_inactive" />
+    </LinearLayout>
+
+    <!-- Fixed, not flexible: see top_bar_group_gap's comment in dimens.xml
+         for why this differs from the spacer below. -->
+    <View
+        android:layout_width="@dimen/top_bar_group_gap"
+        android:layout_height="1dp" />
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="@dimen/top_bar_group_height"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:background="@drawable/top_bar_group_background"
+        android:paddingStart="@dimen/top_bar_group_padding_horizontal"
+        android:paddingEnd="@dimen/top_bar_group_padding_horizontal">
+
+        <ImageView
+            android:id="@+id/top_bar_assistant"
+            android:layout_width="@dimen/top_bar_icon_size"
+            android:layout_height="@dimen/top_bar_icon_size"
+            android:background="?android:attr/selectableItemBackground"
+            android:clickable="true"
+            android:focusable="true"
+            android:src="@drawable/ic_sparkle"
+            android:tint="@color/top_bar_text_color"
+            android:contentDescription="@string/top_bar_assistant_content_description" />
+
+        <ImageView
+            android:id="@+id/top_bar_home_button"
+            android:layout_width="@dimen/top_bar_icon_size"
+            android:layout_height="@dimen/top_bar_icon_size"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:background="?android:attr/selectableItemBackground"
+            android:clickable="true"
+            android:focusable="true"
+            android:src="@drawable/ic_home"
+            android:tint="@color/top_bar_text_color"
+            android:contentDescription="@string/top_bar_home_button_content_description" />
+
+        <ImageView
+            android:id="@+id/top_bar_settings"
+            android:layout_width="@dimen/top_bar_icon_size"
+            android:layout_height="@dimen/top_bar_icon_size"
+            android:layout_marginStart="@dimen/top_bar_tab_spacing"
+            android:background="?android:attr/selectableItemBackground"
+            android:clickable="true"
+            android:focusable="true"
+            android:src="@drawable/ic_gear"
+            android:tint="@color/top_bar_text_color"
+            android:contentDescription="@string/top_bar_settings_content_description" />
+    </LinearLayout>
+
+    <View
+        android:layout_width="0dp"
+        android:layout_height="1dp"
+        android:layout_weight="1" />
+
+    <!-- Clock + app name: plain text, no capsule, matching the reference
+         (only the button groups get the pill treatment there). Same size
+         and muted color on both so they read as one small secondary-info
+         pairing, like "9:02  Google TV" in the reference, rather than the
+         clock looking like a separate, more prominent element. -->
+    <TextClock
+        android:id="@+id/top_bar_clock"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:format12Hour="h:mm"
+        android:format24Hour="HH:mm"
+        android:textSize="@dimen/top_bar_text_size"
+        android:textColor="@color/top_bar_text_color_inactive" />
+
+    <TextView
+        android:id="@+id/top_bar_brand"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="6dp"
+        android:text="@string/top_bar_brand_text"
+        android:textSize="@dimen/top_bar_text_size"
+        android:textColor="@color/top_bar_text_color_inactive" />
+</LinearLayout>
diff --git a/TvSampleLeanbackLauncher/src/main/res/values/colors.xml b/TvSampleLeanbackLauncher/src/main/res/values/colors.xml
index b5d956b..2d079f8 100644
--- a/TvSampleLeanbackLauncher/src/main/res/values/colors.xml
+++ b/TvSampleLeanbackLauncher/src/main/res/values/colors.xml
@@ -21,6 +21,31 @@
     <color name="primary_text_color">#e5e5e5</color>
     <color name="secondary_text_color">#787b7f</color>
 
+    <!-- "Favorite Apps"-style rounded tile (launch_item.xml) -->
+    <color name="app_tile_background">#E6FFFFFF</color>
+    <color name="app_tile_background_focused">#FFFFFFFF</color>
+
+    <!-- Hero region (hero_banner.xml) -->
+    <color name="hero_fallback_background">#1A2B42</color>
+    <color name="hero_title_text_color">#FFFFFFFF</color>
+    <color name="hero_subtitle_text_color">#CCFFFFFF</color>
+    <color name="hero_scrim_top">#00000000</color>
+    <color name="hero_scrim_bottom">#CC000000</color>
+
+    <!-- Top bar (top_bar.xml) -->
+    <color name="top_bar_text_color">#FFFFFFFF</color>
+    <color name="top_bar_text_color_inactive">#CCFFFFFF</color>
+    <color name="top_bar_active_pill_background">#FFFFFFFF</color>
+    <color name="top_bar_active_pill_text_color">#1A2B42</color>
+    <!-- The translucent capsule behind a whole button group, distinct from
+         (and underneath) the opaque active-tab pill above. -->
+    <color name="top_bar_group_background">#26FFFFFF</color>
+    <!-- Permanent muted fill behind top_bar_account, see
+         top_bar_account_background.xml. Brighter than top_bar_group_background
+         so the avatar chip still reads as a distinct filled circle against
+         the group's own translucent pill, not just more of the same tint. -->
+    <color name="top_bar_account_background">#40FFFFFF</color>
+
     <color name="notification_text_color">#787b7f</color>
     <color name="notification_background">#FFCCCCCC</color>
     <color name="notification_heads_up_decorator">#1784d7</color>
diff --git a/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml b/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
index 8936f39..d0e5647 100644
--- a/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
+++ b/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
@@ -21,11 +21,112 @@
 
     <dimen name="app_item_width">190dp</dimen>
     <dimen name="app_item_height">120dp</dimen>
-    <dimen name="app_item_padding">15dp</dimen>
+    <!-- Was 15dp, sized for the old 96dp/120dp tiles. At the smaller 76dp
+         square tile (see circular_tile_size) that left extra dead space
+         inside each row's fixed circular_row_item_height cell, pushing the
+         bottom row up off the true bottom edge; confirmed by measuring
+         the screenshot's actual bottom pixel margin (~85px/1080, notably
+         more than overscan_vertical alone accounts for). 8dp makes
+         circular_tile_size + 2*this exactly equal circular_row_item_height
+         (76+16=92dp), so there's no leftover slack. -->
+    <dimen name="app_item_padding">8dp</dimen>
     <dimen name="app_row_title_text_size">20sp</dimen>
     <dimen name="app_row_title_padding">5dp</dimen>
-    <dimen name="app_icon_size">48dp</dimen>
-    <dimen name="app_icon_margin">10dp</dimen>
+
+    <!-- "Favorite Apps"-style rounded tile (launch_item.xml) -->
+    <dimen name="app_tile_size">120dp</dimen>
+    <dimen name="app_tile_corner_radius">20dp</dimen>
+    <dimen name="app_label_margin_top">8dp</dimen>
+    <item name="app_tile_focused_zoom" type="fraction">108%</item>
+    <item name="app_tile_scale_duration_ms" type="integer">150</item>
+
+    <!-- "Your Apps"-style circular icon tile (launch_item_circular.xml).
+         Measured ~14% of screen height in the reference (was 96dp/56dp,
+         visibly larger relative to the screen than the reference's icon
+         row). -->
+    <dimen name="circular_tile_size">76dp</dimen>
+    <dimen name="circular_icon_size">44dp</dimen>
+    <!-- app_launch_row.xml's HorizontalGridView height for a circular row,
+         set from code (AppFragment#onCreateView()) instead of app_item_height
+         (120dp), which is sized for the square launch_item.xml tile that's
+         effectively unused now. Left at 120dp that fixed height didn't
+         shrink along with circular_tile_size, wasting ~44dp of vertical
+         space per row; with 2 stacked circular rows (see
+         aosp_rpi4_tv-launcher-ui-plan.md section 11) that pushed the row
+         stack up into the hero subtitle text, confirmed on-device as a
+         visible overlap. -->
+    <dimen name="circular_row_item_height">92dp</dimen>
+
+    <!-- recent_apps_row.xml: deliberately smaller than circular_tile_size,
+         both for visual hierarchy (secondary row, smaller than the main
+         "Your Apps" row) and to help this row plus content_preview both
+         fit above the app row without pushing into the hero text;
+         confirmed on-device as a real overlap once this row was added
+         using circular_tile_size-sized icons. -->
+    <dimen name="recent_apps_tile_size">56dp</dimen>
+    <dimen name="recent_apps_icon_size">32dp</dimen>
+
+    <!-- Top bar (top_bar.xml): Search/Home/Apps tabs + Settings + clock,
+         fixed above everything including the hero. Sizes below were
+         measured as fractions of width/height directly off a reference
+         Google TV Home screenshot (fractions, not absolute px, since the
+         screenshot's native resolution is unknown) and re-applied to this
+         1920x1080 screen; see aosp_rpi4_tv-launcher-ui-plan.md section 11
+         for the measurements. -->
+    <dimen name="top_bar_height">64dp</dimen>
+    <!-- Was 24dp: measured icon diameter in the reference is closer to 3%
+         of screen height (~16dp on this screen) than 24dp; split the
+         difference at 20dp rather than going all the way down, since 16dp
+         reads as too small a D-pad focus target on an actual TV. -->
+    <dimen name="top_bar_icon_size">20dp</dimen>
+    <dimen name="top_bar_text_size">16sp</dimen>
+    <dimen name="top_bar_clock_text_size">18sp</dimen>
+    <dimen name="top_bar_tab_spacing">24dp</dimen>
+    <dimen name="top_bar_search_icon_label_spacing">8dp</dimen>
+    <dimen name="top_bar_pill_radius">24dp</dimen>
+    <dimen name="top_bar_pill_padding_horizontal">18dp</dimen>
+    <dimen name="top_bar_pill_padding_vertical">8dp</dimen>
+    <!-- The translucent capsule wrapping a whole button group (see
+         top_bar_group_background.xml), around its own children. A fixed
+         height (not wrap_content) is deliberate: the left group's tabs
+         have their own inner pill padding and the right group is just
+         bare icons, so left to wrap_content the two capsules came out
+         different heights, confirmed wrong against a reference screenshot
+         where both are the same pill height. -->
+    <dimen name="top_bar_group_padding_horizontal">10dp</dimen>
+    <dimen name="top_bar_group_padding_vertical">6dp</dimen>
+    <!-- Measured ~9% of screen height in the reference (was 56dp). -->
+    <dimen name="top_bar_group_height">48dp</dimen>
+    <!-- Half of top_bar_group_height, so the capsule's ends are fully
+         round rather than just rounded-rectangle corners. -->
+    <dimen name="top_bar_group_radius">24dp</dimen>
+    <!-- Fixed gap between the left (Search/Home/Live/Apps) and right
+         (sparkle/home/gear) pill groups. Was a flexible layout_weight="1"
+         spacer, same as the one after the right group; that put two
+         equal flexible gaps around the right group, centering it in the
+         middle of the top bar. Measured against the reference, that gap is
+         small and fixed (~5% of width) while nearly all the remaining
+         empty space sits between the right group and the clock, which is
+         what the *second* spacer (still layout_weight="1") is for. -->
+    <dimen name="top_bar_group_gap">48dp</dimen>
+
+    <!-- Hero region (hero_banner.xml), fixed above the scrolling rows.
+         Was bumped 216dp -> 266dp to match a reference screenshot's title
+         position when this launcher only had content_preview + the app
+         row below it (plenty of empty space to push the title down into).
+         Back to 216dp now that recent_apps_row (section 15) also sits in
+         that space: confirmed on-device via uiautomator bounds that
+         266dp left a ~194px empty gap between the top bar and the hero
+         text while the rows below it overlapped the hero text; there
+         wasn't more room to give, the existing room was just positioned
+         wrong. User: "đẩy nó lên vào chỗ trống... không để chỗ nào trống
+         trên màn hình". -->
+    <dimen name="hero_height">216dp</dimen>
+    <dimen name="hero_fallback_icon_size">96dp</dimen>
+    <dimen name="hero_title_text_size">36sp</dimen>
+    <dimen name="hero_subtitle_text_size">18sp</dimen>
+    <dimen name="hero_text_margin_bottom">28dp</dimen>
+    <dimen name="app_icon_size">72dp</dimen>
 
     <dimen name="search_row_height">108dp</dimen>
     <dimen name="search_row_padding_start">56dp</dimen>
