+
     <color name="notification_text_color">#787b7f</color>
     <color name="notification_background">#FFCCCCCC</color>
     <color name="notification_heads_up_decorator">#1784d7</color>
diff --git a/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml b/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
index 8936f39..98ac19d 100644
--- a/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
+++ b/TvSampleLeanbackLauncher/src/main/res/values/dimens.xml
@@ -21,11 +21,96 @@
 
     <dimen name="app_item_width">190dp</dimen>
     <dimen name="app_item_height">120dp</dimen>
-    <dimen name="app_item_padding">15dp</dimen>
+    <!-- Was 15dp, sized for the old 96dp/120dp tiles. At the smaller 76dp
+         square tile (see circular_tile_size) that left extra dead space
+         inside each row's fixed circular_row_item_height cell, pushing the
+         bottom row up off the true bottom edge; confirmed by measuring
+         the screenshot's actual bottom pixel margin (~85px/1080, notably
+         more than overscan_vertical alone accounts for). 8dp makes
+         circular_tile_size + 2*this exactly equal circular_row_item_height
+         (76+16=92dp), so there's no leftover slack. -->
+    <dimen name="app_item_padding">8dp</dimen>
     <dimen name="app_row_title_text_size">20sp</dimen>
     <dimen name="app_row_title_padding">5dp</dimen>
-    <dimen name="app_icon_size">48dp</dimen>
-    <dimen name="app_icon_margin">10dp</dimen>
+
+    <!-- "Favorite Apps"-style rounded tile (launch_item.xml) -->
+    <dimen name="app_tile_size">120dp</dimen>
+    <dimen name="app_tile_corner_radius">20dp</dimen>
+    <dimen name="app_label_margin_top">8dp</dimen>
+    <item name="app_tile_focused_zoom" type="fraction">108%</item>
+    <item name="app_tile_scale_duration_ms" type="integer">150</item>
+
+    <!-- "Your Apps"-style circular icon tile (launch_item_circular.xml).
+         Measured ~14% of screen height in the reference (was 96dp/56dp,
+         visibly larger relative to the screen than the reference's icon
+         row). -->
+    <dimen name="circular_tile_size">76dp</dimen>
+    <dimen name="circular_icon_size">44dp</dimen>
+    <!-- app_launch_row.xml's HorizontalGridView height for a circular row,
+         set from code (AppFragment#onCreateView()) instead of app_item_height
+         (120dp), which is sized for the square launch_item.xml tile that's
+         effectively unused now. Left at 120dp that fixed height didn't
+         shrink along with circular_tile_size, wasting ~44dp of vertical
+         space per row; with 2 stacked circular rows (see
+         aosp_rpi4_tv-launcher-ui-plan.md section 11) that pushed the row
+         stack up into the hero subtitle text, confirmed on-device as a
+         visible overlap. -->
+    <dimen name="circular_row_item_height">92dp</dimen>
+
+    <!-- Top bar (top_bar.xml): Search/Home/Apps tabs + Settings + clock,
+         fixed above everything including the hero. Sizes below were
+         measured as fractions of width/height directly off a reference
+         Google TV Home screenshot (fractions, not absolute px, since the
+         screenshot's native resolution is unknown) and re-applied to this
+         1920x1080 screen; see aosp_rpi4_tv-launcher-ui-plan.md section 11
+         for the measurements. -->
+    <dimen name="top_bar_height">64dp</dimen>
+    <!-- Was 24dp: measured icon diameter in the reference is closer to 3%
+         of screen height (~16dp on this screen) than 24dp; split the
+         difference at 20dp rather than going all the way down, since 16dp
+         reads as too small a D-pad focus target on an actual TV. -->
+    <dimen name="top_bar_icon_size">20dp</dimen>
+    <dimen name="top_bar_text_size">16sp</dimen>
+    <dimen name="top_bar_clock_text_size">18sp</dimen>
+    <dimen name="top_bar_tab_spacing">24dp</dimen>
+    <dimen name="top_bar_search_icon_label_spacing">8dp</dimen>
+    <dimen name="top_bar_pill_radius">24dp</dimen>
+    <dimen name="top_bar_pill_padding_horizontal">18dp</dimen>
+    <dimen name="top_bar_pill_padding_vertical">8dp</dimen>
+    <!-- The translucent capsule wrapping a whole button group (see
+         top_bar_group_background.xml), around its own children. A fixed
+         height (not wrap_content) is deliberate: the left group's tabs
+         have their own inner pill padding and the right group is just
+         bare icons, so left to wrap_content the two capsules came out
+         different heights, confirmed wrong against a reference screenshot
+         where both are the same pill height. -->
+    <dimen name="top_bar_group_padding_horizontal">10dp</dimen>
+    <dimen name="top_bar_group_padding_vertical">6dp</dimen>
+    <!-- Measured ~9% of screen height in the reference (was 56dp). -->
+    <dimen name="top_bar_group_height">48dp</dimen>
+    <!-- Half of top_bar_group_height, so the capsule's ends are fully
+         round rather than just rounded-rectangle corners. -->
+    <dimen name="top_bar_group_radius">24dp</dimen>
+    <!-- Fixed gap between the left (Search/Home/Live/Apps) and right
+         (sparkle/home/gear) pill groups. Was a flexible layout_weight="1"
+         spacer, same as the one after the right group; that put two
+         equal flexible gaps around the right group, centering it in the
+         middle of the top bar. Measured against the reference, that gap is
+         small and fixed (~5% of width) while nearly all the remaining
+         empty space sits between the right group and the clock, which is
+         what the *second* spacer (still layout_weight="1") is for. -->
+    <dimen name="top_bar_group_gap">48dp</dimen>
+
+    <!-- Hero region (hero_banner.xml), fixed above the scrolling rows.
+         hero_height increased from 216dp: measured title block position in
+         the reference sits lower, around 33%-44% of screen height, not
+         21%-30%. -->
+    <dimen name="hero_height">266dp</dimen>
+    <dimen name="hero_fallback_icon_size">96dp</dimen>
+    <dimen name="hero_title_text_size">36sp</dimen>
+    <dimen name="hero_subtitle_text_size">18sp</dimen>
+    <dimen name="hero_text_margin_bottom">28dp</dimen>
