diff --git a/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml b/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml
new file mode 100644
index 0000000..b9a9fa7
--- /dev/null
+++ b/TvSampleLeanbackLauncher/src/main/res/layout/content_preview.xml
@@ -0,0 +1,82 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Copyright (C) 2026 The Android Open Source Project
+  ~
+  ~ Licensed under the Apache License, Version 2.0 (the "License");
+  ~ you may not use this file except in compliance with the License.
+  ~ You may obtain a copy of the License at
+  ~
+  ~      http://www.apache.org/licenses/LICENSE-2.0
+  ~
+  ~ Unless required by applicable law or agreed to in writing, software
+  ~ distributed under the License is distributed on an "AS IS" BASIS,
+  ~ WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  ~ See the License for the specific language governing permissions and
+  ~ limitations under the License
+  -->
+
+<!-- Fills the empty middle of the screen (between the hero title and the
+     app row) with something contextual to whichever app tile currently
+     has D-pad focus, matching a reference Google TV Home screenshot's
+     "Top picks for you" row, but with real data only, never a
+     fabricated content list. See LauncherActivity#onItemFocused().
+
+     Exactly one of the two children below is visible at a time:
+     - content_preview_channels: VTV's real channel lineup (VTV1-9), since
+       that's the one app here with real structured content data this
+       launcher can read.
+     - content_preview_app_card: every other app (the WebView-wrapped
+       YouTube/Spotify/Netflix/CH Play, Settings, Live Channels, etc.);
+       none of those expose any real "suggested content" API this
+       launcher process could read, so this is a plain icon+name card,
+       not an invented content list.
+
+     Not focusable itself, same as the hero backdrop it sits above:
+     purely reactive to the app row's own focus, so it doesn't change
+     D-pad flow at all. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/content_preview"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:layout_marginBottom="24dp"
+    android:paddingStart="@dimen/overscan_horizontal"
+    android:paddingEnd="@dimen/overscan_horizontal"
+    android:clipChildren="false"
+    android:clipToPadding="false"
+    android:visibility="gone">
+
+    <LinearLayout
+        android:id="@+id/content_preview_channels"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:visibility="gone" />
+
+    <LinearLayout
+        android:id="@+id/content_preview_app_card"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:background="@drawable/content_preview_card_background"
+        android:paddingStart="20dp"
+        android:paddingEnd="28dp"
+        android:paddingTop="14dp"
+        android:paddingBottom="14dp"
+        android:visibility="gone">
+
+        <ImageView
+            android:id="@+id/content_preview_app_icon"
+            android:layout_width="56dp"
+            android:layout_height="56dp" />
+
+        <TextView
+            android:id="@+id/content_preview_app_label"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="16dp"
+            android:textSize="20sp"
+            android:textColor="@color/hero_title_text_color"
+            android:textStyle="bold" />
+    </LinearLayout>
+</FrameLayout>
diff --git a/TvSampleLeanbackLauncher/src/main/res/layout/hero_banner.xml b/TvSampleLeanbackLauncher/src/main/res/layout/hero_banner.xml
new file mode 100644
index 0000000..4091ce2
--- /dev/null
+++ b/TvSampleLeanbackLauncher/src/main/res/layout/hero_banner.xml
@@ -0,0 +1,84 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Copyright (C) 2026 The Android Open Source Project
+  ~
+  ~ Licensed under the Apache License, Version 2.0 (the "License");
+  ~ you may not use this file except in compliance with the License.
+  ~ You may obtain a copy of the License at
+  ~
+  ~      http://www.apache.org/licenses/LICENSE-2.0
+  ~
+  ~ Unless required by applicable law or agreed to in writing, software
+  ~ distributed under the License is distributed on an "AS IS" BASIS,
+  ~ WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  ~ See the License for the specific language governing permissions and
+  ~ limitations under the License
+  -->
+
+<!-- Just a positioning container for the title/subtitle text (and the
+     no-banner fallback icon) over the upper part of the screen. Does NOT
+     have its own image/background anymore: it used to (a sharp banner
+     image + its own scrim, separate from launcher.xml's full-screen
+     backdrop), but that made a hard visible seam where the sharp hero box
+     ended and the blurred backdrop began, which looked like two stacked
+     images instead of one continuous photo. Confirmed on-device it looked
+     wrong. Now there is exactly one image (hero_backdrop_image in
+     launcher.xml, full-screen, behind this) and this just positions text
+     over it, matching a reference Google TV Home screenshot where the
+     photo is genuinely one continuous background.
+
+     Not focusable itself, so DPAD_UP from the first row doesn't dead-end
+     here instead of moving to the row above. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/hero_root"
+    android:layout_width="match_parent"
+    android:layout_height="@dimen/hero_height"
+    android:focusable="false"
+    android:focusableInTouchMode="false"
+    android:descendantFocusability="blocksDescendants"
+    android:clipChildren="false"
+    android:clipToPadding="false">
+
+    <!-- Shown only when the focused item has no banner (see
+         LauncherActivity#onItemFocused()); the full-screen solid-color
+         fallback behind this (hero_backdrop_fallback in launcher.xml)
+         handles the background in that case, this is just the icon. -->
+    <ImageView
+        android:id="@+id/hero_fallback_icon"
+        android:layout_width="@dimen/hero_fallback_icon_size"
+        android:layout_height="@dimen/hero_fallback_icon_size"
+        android:layout_gravity="center" />
+
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_gravity="bottom|start"
+        android:layout_marginStart="@dimen/overscan_horizontal"
+        android:layout_marginBottom="@dimen/hero_text_margin_bottom"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/hero_title"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:textSize="@dimen/hero_title_text_size"
+            android:textColor="@color/hero_title_text_color"
+            android:textStyle="bold"
+            android:shadowColor="#80000000"
+            android:shadowDx="0"
+            android:shadowDy="1"
+            android:shadowRadius="4" />
+
+        <TextView
+            android:id="@+id/hero_subtitle"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="4dp"
+            android:textSize="@dimen/hero_subtitle_text_size"
+            android:textColor="@color/hero_subtitle_text_color"
+            android:shadowColor="#80000000"
+            android:shadowDx="0"
+            android:shadowDy="1"
+            android:shadowRadius="4" />
+    </LinearLayout>
+</FrameLayout>
