 <manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools"
     package="com.example.sampleleanbacklauncher">
 
     <!-- ACCESS_WIFI_STATE and ACCESS_NETWORK_STATE are used for updating the network settings entry icon -->
     <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
     <uses-permission android:name="android.permission.ACCESS_NOTIFICATIONS" />
+    <!-- Required for WifiInfo.getSSID() to return the real SSID instead of
+         "<unknown ssid>" when drawing the network entry's label. Granted
+         silently via a device-level default-permissions exception since this
+         launcher has no UI to prompt the user through the runtime dialog. -->
+    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
+    <!-- "Recently Opened" content_preview row: real per-app usage data via
+         UsageStatsManager, not a fabricated recommendation list. A
+         privileged-permission grant via com.example.sampleleanbacklauncher.xml
+         (this app is already priv-app), not the user-facing "Usage access"
+         Settings toggle a non-privileged app would need. -->
+    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
+        tools:ignore="ProtectedPermissions" />
 
     <uses-feature android:name="android.software.leanback" android:required="true" />
 
+    <!--
+      Without this, package-visibility filtering (API 30+) hides every app
+      this launcher didn't already have an "interaction" with, so
+      LaunchItemsManager#updateAppList()/updateSettingsList() silently
+      return nothing for newly-added apps like Live Channels or new TV
+      inputs (adb: `dumpsys package <this> | grep -A5 Queries` showed them
+      absent from "queryable via interaction" even though the launcher IS
+      the resolved HOME app; there's no automatic Home-role exemption in
+      this AOSP version. Declare the exact intents LaunchItemsManager
+      queries so it can actually see them.
+    -->
+    <queries>
+        <intent>
+            <action android:name="android.intent.action.MAIN" />
+            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
+        </intent>
+        <intent>
+            <action android:name="android.intent.action.MAIN" />
+            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
+        </intent>
+        <intent>
+            <action android:name="android.settings.WIFI_SETTINGS" />
+            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
+        </intent>
+    </queries>
+
     <application
         android:allowBackup="true"
         android:icon="@mipmap/ic_launcher"
