diff --git a/aosp_rpi4_tv.mk b/aosp_rpi4_tv.mk
index 5939069..1fda406 100644
--- a/aosp_rpi4_tv.mk
+++ b/aosp_rpi4_tv.mk
@@ -23,6 +23,15 @@ PRODUCT_PACKAGES += \
     TvSampleLeanbackLauncher \
     TvSettingsTwoPanel
 
+# Live Channels app (hosts TvInputServices' channels/EPG). Non-passthrough
+# variant: this device has no HDMI-input hardware to pass through.
+PRODUCT_PACKAGES += \
+    LiveTvNonPassthrough
+
+# VTV live channels (HLS) TvInputService, shows up in Live Channels.
+PRODUCT_PACKAGES += \
+    VtvTvInput
+
 # Bluetooth
 PRODUCT_VENDOR_PROPERTIES += \
     bluetooth.device.class_of_device=34,4,36
@@ -44,6 +53,12 @@ PRODUCT_PACKAGES += \
     SettingsProviderTvRpiOverlay \
     WifiRpiOverlay
 
+# Silently grant TvSampleLeanbackLauncher the location permission it needs
+# to read the connected Wi-Fi SSID (see AndroidManifest.xml comment in
+# device/google/atv/TvSampleLeanbackLauncher for why it's required).
+PRODUCT_PACKAGES += \
+    default-permissions-rpi4-tv.xml
+
 # Device identifier. This must come after all inclusions.
 PRODUCT_DEVICE := rpi4
 PRODUCT_NAME := aosp_rpi4_tv
