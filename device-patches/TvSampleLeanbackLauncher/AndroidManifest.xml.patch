diff --git a/src/main/AndroidManifest.xml b/src/main/AndroidManifest.xml
index 070967b..24ac12e 100644
--- a/src/main/AndroidManifest.xml
+++ b/src/main/AndroidManifest.xml
@@ -21,9 +21,40 @@
     <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
     <uses-permission android:name="android.permission.ACCESS_NOTIFICATIONS" />
+    <!-- Required for WifiInfo.getSSID() to return the real SSID instead of
+         "<unknown ssid>" when drawing the network entry's label. Granted
+         silently via a device-level default-permissions exception since this
+         launcher has no UI to prompt the user through the runtime dialog. -->
+    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
 
     <uses-feature android:name="android.software.leanback" android:required="true" />
 
+    <!--
+      Without this, package-visibility filtering (API 30+) hides every app
+      this launcher didn't already have an "interaction" with, so
+      LaunchItemsManager#updateAppList()/updateSettingsList() silently
+      return nothing for newly-added apps like Live Channels or new TV
+      inputs (adb: `dumpsys package <this> | grep -A5 Queries` showed them
+      absent from "queryable via interaction" even though the launcher IS
+      the resolved HOME app; there's no automatic Home-role exemption in
+      this AOSP version. Declare the exact intents LaunchItemsManager
+      queries so it can actually see them.
+    -->
+    <queries>
+        <intent>
+            <action android:name="android.intent.action.MAIN" />
+            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
+        </intent>
+        <intent>
+            <action android:name="android.intent.action.MAIN" />
+            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
+        </intent>
+        <intent>
+            <action android:name="android.settings.WIFI_SETTINGS" />
+            <category android:name="android.intent.category.LEANBACK_SETTINGS" />
+        </intent>
+    </queries>
+
     <application
         android:allowBackup="true"
         android:icon="@mipmap/ic_launcher"
